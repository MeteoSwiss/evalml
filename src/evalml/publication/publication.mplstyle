## Publication figure style for evalml paper figures.
## Apply with: plt.style.use(mplstyle_path())  # from evalml.publication.style
## Every publication notebook uses THIS style and nothing else, so text appears
## identical across figures. Figures are placed in the paper at 100% (no
## resizing), so these point sizes are the on-page sizes — tune them here.

# Font family — Liberation Sans (a metric-identical Helvetica clone: same shapes
# and spacing). Pinned explicitly (rather than listing Helvetica first) because
# Helvetica isn't installed here, so this is what actually renders — being
# explicit avoids the findfont fallback and its warning. DejaVu is the ultimate
# safety net if Liberation Sans is ever missing.
font.family         : sans-serif
font.sans-serif     : Liberation Sans, DejaVu Sans

# Figure DPI (screen / PDF rendering; PNG exports pass an explicit dpi= argument)
figure.dpi          : 250

# Absolute point sizes (figures are printed at 100%, so pt == on-page pt).
font.size           : 7    # base size for text() / annotate()
axes.titlesize      : 8    # ax.set_title()
axes.labelsize      : 7    # ax.set_xlabel() / ax.set_ylabel()
xtick.labelsize     : 6
ytick.labelsize     : 6
legend.fontsize     : 7    # fig.legend() / ax.legend()
figure.titlesize    : 8    # fig.suptitle()

# Lines — overridden per-source by line_style() in style.py
lines.linewidth     : 0.8

# Legend
legend.frameon      : False

# Grid — grey solid lines
axes.grid           : True
grid.color          : 0.75
grid.linestyle      : solid
grid.linewidth      : 0.5

# Ticks — face outwards, bottom and left only, thin
xtick.direction     : out
xtick.top           : False
ytick.direction     : out
ytick.right         : False
xtick.major.width   : 0.4
ytick.major.width   : 0.4
xtick.minor.width   : 0.3
ytick.minor.width   : 0.3

# Spines — thin black box on all four sides
axes.spines.top     : True
axes.spines.right   : True
axes.edgecolor      : black
axes.linewidth      : 0.4

# Grid below data lines
axes.axisbelow      : True
