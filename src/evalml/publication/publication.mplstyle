## Publication figure style for evalml paper figures.
## Apply with: plt.style.use(mplstyle_path())  # from evalml.publication.style

# Font family
font.family         : sans-serif
font.sans-serif     : Liberation Sans

# Figure DPI (screen / PDF rendering; PNG exports pass an explicit dpi= argument)
figure.dpi          : 250

# Two-level font-size hierarchy:
#   16 pt  — titles, axis labels, legend, suptitle  (identifies what is shown)
#   13 pt  — tick values, in-panel annotations      (reads specific numbers)
font.size           : 13    # base size for text() / annotate()
axes.titlesize      : 16    # ax.set_title()
axes.labelsize      : 13    # ax.set_xlabel() / ax.set_ylabel()
xtick.labelsize     : 13
ytick.labelsize     : 13
legend.fontsize     : 13    # fig.legend() / ax.legend()
figure.titlesize    : 16    # fig.suptitle()

# Lines — overridden per-source by line_style() in style.py
lines.linewidth     : 1.5

# Legend
legend.frameon      : False

# Grid — grey solid lines
axes.grid           : True
grid.color          : 0.75
grid.linestyle      : solid
grid.linewidth      : 0.5

# Ticks — face outwards, bottom and left only
xtick.direction     : out
xtick.top           : False
ytick.direction     : out
ytick.right         : False

# Spines — black box on all four sides
axes.spines.top     : True
axes.spines.right   : True
axes.edgecolor      : black

# Grid below data lines
axes.axisbelow      : True
